{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "3.5",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Briefly",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "offscreen",
    "activeTab",
    "scripting",
    "tabs",
    "downloads"
  ],
  "commands": {
    "push-to-talk": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Dictate: record speech, copy transcript to clipboard"
    },
    "read-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Read the selected text aloud (no window needed)"
    },
    "read-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Read the whole page aloud (no window needed)"
    },
    "stop-playback": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Stop reading aloud"
    }
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "https://api.assemblyai.com/*",
    "https://streaming.assemblyai.com/*",
    "https://api.elevenlabs.io/*",
    "https://api.openai.com/*",
    "https://api.deepgram.com/*",
    "https://asr.api.speechmatics.com/*",
    "https://api.groq.com/*",
    "https://translate.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "privacy.html",
        "help.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' data: https://api.assemblyai.com https://streaming.assemblyai.com wss://streaming.assemblyai.com https://api.elevenlabs.io https://api.openai.com https://api.deepgram.com wss://api.deepgram.com https://asr.api.speechmatics.com https://api.groq.com https://translate.google.com"
  }
}